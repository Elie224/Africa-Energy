# Port
PORT=4000

# CORS : origine du frontend (Vite dev ou prod)
FRONTEND_ORIGIN=http://localhost:5173

# Email destinataire (societe)
CONTACT_TO=africaenergysau@gmail.com

# SMTP Gmail (App Password : https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=africaenergysau@gmail.com
SMTP_PASS=remplacez_par_app_password

# JWT - IMPORTANT : changez en prod (openssl rand -hex 48)
JWT_SECRET=changez_moi_en_production_avec_une_chaine_aleatoire_de_48_chars

# Chemin BDD SQLite (defaut : backend/data/africa-energy.db)
DB_PATH=

# Super-admin initial (cree au 1er seed, peut etre change apres)
SEED_ADMIN_EMAIL=admin@africaenergy.com
